  <code>B2: =ARRAYFORMULA(SE(A2:A="";"";MAXIFS(pedidos!C:C;pedidos!B:B;A2:A)))</code><br>
  <code>C2: =ARRAYFORMULA(SE(A2:A="";"";HOJE()-B2:B))</code><br>
